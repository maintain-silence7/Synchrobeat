[
  {
    "AllowedOrigins": [
      "https://synchrobeat.app",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ],
    "AllowedMethods": [
      "GET",
      "PUT",
      "HEAD"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "ExposeHeaders": [
      "ETag",
      "Content-Length",
      "Content-Type"
    ],
    "MaxAgeSeconds": 3600
  }
]
